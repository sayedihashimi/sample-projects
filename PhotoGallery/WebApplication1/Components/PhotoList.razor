@code
{
    [Parameter]
    public IEnumerable<string> Photos { get; set; } = [];
}
 
<html>
<head>
    <title>Photo List</title>
</head>
<body>
    <script src="/_framework/aspnetcore-browser-refresh.js"></script>
    <ul>
        @foreach (var photo in Photos)
        {
            <li>@photo</li>
        }
    </ul>
</body>
</html>

